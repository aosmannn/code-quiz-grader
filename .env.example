# LTI / iCollege environment (server-side)

# Public base URL of this tool (must match what D2L can reach)
LTI_TOOL_BASE_URL=http://127.0.0.1:43127

# From D2L External Learning Tool registration
LTI_ISSUER=
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_PLATFORM_JWKS_URL=

# Platform token endpoint (for AGS client_credentials)
LTI_TOKEN_URL=

# Tool keypair for client assertions + JWKS
LTI_TOOL_KEY_ID=cqg-lti-key-1
LTI_TOOL_PRIVATE_KEY_PEM=

# Allow /pilot and unsigned launches (default on for local)
LTI_ALLOW_DEV_LAUNCH=true
